{
  "name": "@courtly/backend",
  "private": true,
  "scripts": {
    "generate:api": "tsoa routes && tsoa spec",
    "dev": "nodemon --watch src/controllers --ext ts --exec 'npm run generate:api && tsx' src/server.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "build": "npm run generate:api && npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "npm run generate:api && npm run db:generate && tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "tsx scripts/prepare-test-database.ts && vitest run --project integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.2",
    "express": "4.22.3",
    "pg": "8.16.3",
    "swagger-ui-express": "5.0.1",
    "tsoa": "6.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.25",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/swagger-ui-express": "4.1.8",
    "nodemon": "3.1.10",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
